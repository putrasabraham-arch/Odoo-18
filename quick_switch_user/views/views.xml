<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Switch User Wizard Form -->
        <record id="view_switch_user_wizard_form" model="ir.ui.view">
            <field name="name">switch.user.wizard.form</field>
            <field name="model">switch.user.wizard</field>
            <field name="arch" type="xml">
                <form string="Pilih User">
                    <div class="alert alert-warning" role="alert" style="margin-bottom: 20px;">
                        <strong>⚠️ Perhatian:</strong> Anda akan login sebagai user yang dipilih.
                    </div>
                    
                    <group>
                        <field name="user_id" string="Select User to Switch To"/>
                    </group>
                    
                    <footer>
                        <button string="Switch User" name="action_switch_user" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action for Switch User -->
        <record id="action_open_switch_user_wizard" model="ir.actions.act_window">
            <field name="name">Switch User</field>
            <field name="res_model">switch.user.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_switch_user_wizard_form"/>
        </record>

    </data>
</odoo>

