<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_mass_mailing_form_partner_recipient" model="ir.ui.view">
        <field name="name">mailing.mailing.form.partner.recipient</field>
        <field name="model">mailing.mailing</field>
        <field name="inherit_id" ref="mass_mailing.view_mail_mass_mailing_form"/>
        <field name="arch" type="xml">
            <!-- Hide standard recipient widgets when manual mode is selected -->
            <xpath expr="//div[@name='mailing_model_id_container']//field[@name='mailing_model_id']" position="attributes">
                <attribute name="invisible">recipient_selection == 'partner'</attribute>
            </xpath>
            <xpath expr="//div[@name='mailing_model_id_container']//field[@name='mailing_filter_id']" position="attributes">
                <attribute name="invisible">mailing_on_mailing_list or recipient_selection == 'partner'</attribute>
            </xpath>
            <xpath expr="//div[@name='mailing_model_id_container']//field[@name='mailing_domain']" position="attributes">
                <attribute name="invisible">mailing_on_mailing_list or recipient_selection == 'partner'</attribute>
            </xpath>

            <!-- Recipient mode selector + manual partner tags -->
            <xpath expr="//div[@name='mailing_model_id_container']" position="inside">
                <field name="recipient_selection" widget="radio" options="{'horizontal': true}"
                    readonly="state in ('sending', 'done')"/>
                <field name="partner_ids" widget="many2many_tags"
                    string="Pelanggan"
                    placeholder="Cari pelanggan..."
                    domain="[('email', '!=', False)]"
                    options="{'no_create': True}"
                    invisible="recipient_selection != 'partner'"
                    readonly="state in ('sending', 'done')"/>
            </xpath>
        </field>
    </record>
</odoo>