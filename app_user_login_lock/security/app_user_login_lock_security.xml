<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_app_user_login_lock" model="ir.module.category">
        <field name="name">App - User Login Lock</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_app_user_login_lock_manager" model="res.groups">
        <field name="name">Login Lock Manager</field>
        <field name="category_id" ref="module_category_app_user_login_lock"/>
        <field name="comment">Users with this right can lock/unlock other users' logins from the User Login Lock app and can never be locked themselves.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_app_user_login_lock_manager'))]"/>
    </record>
</odoo>
