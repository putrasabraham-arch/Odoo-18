<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_inventory_notification" model="ir.module.category">
        <field name="name">Inventory Notification</field>
        <field name="description">Access to informational inventory notifications.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_reordering_popup_notification" model="res.groups">
        <field name="name">Menerima Notifikasi Reordering Rules</field>
        <field name="category_id" ref="module_category_inventory_notification"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Receive read-only reordering rule popup notifications when the Odoo backend starts.</field>
    </record>
</odoo>
