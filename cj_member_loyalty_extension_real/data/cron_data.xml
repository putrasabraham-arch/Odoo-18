<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="ir_cron_cja_expire_points" model="ir.cron">
        <field name="name">CJA Loyalty: Expire Points Daily</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(datetime.now() + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="model_id" ref="model_loyalty_point_history"/>
        <field name="code">model._cron_expire_points()</field>
        <field name="state">code</field>
    </record>

</odoo>