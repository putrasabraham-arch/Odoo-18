<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="loyalty_rule_view_form_inherit_cja" model="ir.ui.view">
        <field name="name">loyalty.rule.view.form.inherit.cja</field>
        <field name="model">loyalty.rule</field>
        <field name="inherit_id" ref="loyalty.loyalty_rule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='reward_point_amount']" position="before">
                <field name="points_per_unit"
                       invisible="reward_point_mode != 'money'"/>
            </xpath>
        </field>
    </record>

</odoo>