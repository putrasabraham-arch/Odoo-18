<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Field Security untuk is_favorite field -->
        <record id="product_template_field_is_favorite_access" model="ir.model.fields">
            <field name="model_id" ref="product.model_product_template"/>
            <field name="name">is_favorite</field>
        </record>

        <!-- Rule untuk memastikan user dengan "Akses Star Product" dapat akses is_favorite field -->
        <record id="product_template_rule_star_access" model="ir.rule">
            <field name="name">Product Template - Star Access</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="groups" eval="[(4, ref('product_favorite_access.group_product_star_access'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
